# Production-ready NEAR staking dApp for NPRO validator

NEXT_PUBLIC_NETWORK_ID=mainnet
NEXT_PUBLIC_POOL_ID=npro.poolv1.near
NEXT_PUBLIC_RPC_URL=https://free.rpc.fastnear.com
# Comma-separated fallbacks, tried in order when the primary fails or rate-limits
NEXT_PUBLIC_RPC_FALLBACKS=https://near.lava.build,https://near.blockpi.network/v1/rpc/public,https://1rpc.io/near,https://near.drpc.org,https://endpoints.omniatech.io/v1/near/mainnet/public,https://nearrpc.aurora.dev,https://rpc.shitzuapes.xyz,https://rpc.mainnet.near.org
NEXT_PUBLIC_EXPLORER_BASE=https://nearblocks.io

# Optional features
NEXT_PUBLIC_SHOW_FIAT=true
NEXT_PUBLIC_SHOW_APR=false

# NPRO Earnings API (server-side only)
PEERSYST_API_URL=https://near-mobile-production.aws.peersyst.tech/api
